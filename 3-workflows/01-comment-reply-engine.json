          }
        ],
        [
          {
            "node": "Ready To Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ready To Post": {
      "main": [
        [
          {
            "node": "Route By Platform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route By Platform": {
      "main": [
        [
          {
            "node": "YouTube: Post Reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Meta: Post Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube: Post Reply": {
      "main": [
        [
