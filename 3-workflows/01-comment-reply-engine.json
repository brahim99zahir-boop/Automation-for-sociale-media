          }
        ]
      ]
    },
    "From Meta Webhook Router": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Route By Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route By Entry": {
      "main": [
        [
          {
            "node": "Normalized Comment",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "YouTube: List Comment Threads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube: List Comment Threads": {
      "main": [
        [
          {
            "node": "Split Comment Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Comment Items": {
      "main": [
        [
          {
            "node": "Filter: Not Already Seen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize: YouTube Comment": {
      "main": [
        [
          {
            "node": "Normalized Comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalized Comment": {
      "main": [
        [
          {
