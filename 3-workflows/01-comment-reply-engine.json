{
  "name": "01 - Comment Reply Engine",
  "nodes": [
    {
      "id": "t1",
      "name": "Schedule: Poll YouTube",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "t2",
      "name": "From Meta Webhook Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "platform"
            },
            {
              "name": "commentId"
            },
            {
              "name": "text"
            },
            {
              "name": "authorName"
            },
            {
              "name": "postId"
            }
          ]
        }
      },
      "notes": "Called by 02-meta-webhook-router.json's Execute Workflow node with one normalized IG/FB comment."
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        200
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "channelId",
              "type": "string",
              "value": "REPLACE_WITH_YOUTUBE_CHANNEL_ID"
            },
            {
              "id": "a2",
              "name": "igUserId",
              "type": "string",
              "value": "REPLACE_WITH_IG_USER_ID"
            },
            {
              "id": "a3",
              "name": "fbPageId",
              "type": "string",
              "value": "REPLACE_WITH_FB_PAGE_ID"
            },
            {
              "id": "a4",
              "name": "approvalEmail",
              "type": "string",
              "value": "brahim99zahir@gmail.com"
            },
            {
              "id": "a5",
              "name": "systemPrompt",
              "type": "string",
              "value": "REPLACE_WITH_SYSTEM_PROMPT_TXT_CONTENTS"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true
      },
      "notes": "Single source of truth for the IDs, the approval email, and the system prompt. Update these values here (or via the n8n REST API on a paid plan) -- every other node references them by name."
    },
    {
      "id": "router",
      "name": "Route By Entry",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "exists"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Comment Ready For AI"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      },
      "notes": "2 outputs: has platform (came from Meta router) -> straight to AI; fallback (came from the Schedule Trigger) -> go fetch YouTube comments."
    },
    {
      "id": "yt_list",
      "name": "YouTube: List Comment Threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        500
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/commentThreads",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            },
            {
              "name": "allThreadsRelatedToChannelId",
              "value": "={{ $('Config').item.json.channelId }}"
            },
            {
              "name": "order",
              "value": "time"
            },
            {
              "name": "maxResults",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "REPLACE_IN_UI",
          "name": "YouTube OAuth2 account"
        }
      }
    },
    {
      "id": "yt_split",
      "name": "Split Comment Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        960,
        500
      ],
      "parameters": {
        "fieldToSplitOut": "items"
      }
    },
    {
      "id": "yt_dedup",
      "name": "Filter: Not Already Seen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1180,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "ifRowDoesNotExist",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "yt_seen_comments"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "comment_id",
              "condition": "eq",
              "keyValue": "={{ $json.snippet.topLevelComment.id }}"
            }
          ],
          "matchType": "allFilters"
        }
      },
      "notes": "Best-effort scaffold for n8n's Data Table node -- I could not fully verify the exact internal parameter schema from docs alone. Before using: create this Data Table in the n8n UI first (see GUIDE.md), then open this node, re-select the table from the dropdown, and re-check the column mapping / filter -- the operation and table name are right, the exact field layout may need a small fix. Passes the item through only when no row with this comment_id exists yet -- i.e. this IS the dedup check. If your n8n version doesn't have this operation, use 'Get' + a manual IF instead."
    },
    {
      "id": "yt_mark_seen",
      "name": "Mark As Seen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1400,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "yt_seen_comments"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "comment_id": "={{ $json.snippet.topLevelComment.id }}"
          },
          "matchingColumns": []
        }
      },
      "notes": "Best-effort scaffold for n8n's Data Table node -- I could not fully verify the exact internal parameter schema from docs alone. Before using: create this Data Table in the n8n UI first (see GUIDE.md), then open this node, re-select the table from the dropdown, and re-check the column mapping / filter -- the operation and table name are right, the exact field layout may need a small fix."
    },
    {
      "id": "yt_normalize",
      "name": "Normalize: YouTube Comment",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1620,
        440
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "platform",
              "type": "string",
              "value": "youtube"
            },
            {
              "id": "b2",
              "name": "commentId",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.topLevelComment.id }}"
            },
            {
              "id": "b3",
              "name": "text",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.topLevelComment.snippet.textOriginal }}"
            },
            {
              "id": "b4",
              "name": "authorName",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.topLevelComment.snippet.authorDisplayName }}"
            },
            {
              "id": "b5",
              "name": "postId",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.videoId }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "normalized",
      "name": "Normalized Comment",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1840,
        300
      ],
      "parameters": {},
      "notes": "Convergence point for the YouTube branch and the Meta-router branch. Downstream nodes reference $('Normalized Comment').item.json.x regardless of which entry fired."
    },
    {
      "id": "claude",
      "name": "Claude: Generate Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2060,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-haiku-4-5\",\n  max_tokens: 400,\n  system: $('Config').item.json.systemPrompt,\n  messages: [ { role: \"user\", content: $('Normalized Comment').item.json.text } ]\n}) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_IN_UI",
          "name": "Anthropic API (x-api-key header)"
        }
      },
      "notes": "Generic Header Auth credential: header name 'x-api-key', value = your Anthropic API key. See GUIDE.md Phase 3."
    },
    {
      "id": "parse",
      "name": "Parse AI JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const raw = $json.content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // Model didn't return clean JSON -- fail safe to human review rather than guess.\n  parsed = { reply: '', needs_human: true, client_type: 'غير محدد', parse_error: raw };\n}\nreturn { json: { ...$json, reply: parsed.reply, needs_human: parsed.needs_human === true,\n  client_type: parsed.client_type || 'غير محدد' } };"
      }
    },
    {
      "id": "needshuman",
      "name": "Needs Human Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.needs_human }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ready",
      "name": "Ready To Post",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1160,
        380
      ],
      "parameters": {},
      "notes": "Convergence: auto-approved (needs_human=false) replies AND human-approved replies both land here."
    },
    {
      "id": "platform_switch",
      "name": "Route By Platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1380,
        380
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "rightValue": "youtube",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "YouTube"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ ['instagram','facebook'].includes($json.platform) }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Meta (IG/FB)"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "yt_post",
      "name": "YouTube: Post Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/youtube/v3/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ snippet: { parentId: $json.commentId, textOriginal: $json.reply } }) }}",
        "options": {}
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "REPLACE_IN_UI",
          "name": "YouTube OAuth2 account"
        }
      }
    },
    {
      "id": "meta_post",
      "name": "Meta: Post Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        460
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v21.0/' + $json.commentId + '/replies' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.reply }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_IN_UI",
          "name": "Meta Graph API token"
        }
      },
      "notes": "Query Auth credential: parameter name 'access_token', value = your long-lived Page/System User token. Works for both Instagram and Facebook comment replies -- both are Graph API comment IDs."
    },
    {
      "id": "posted",
      "name": "Posted",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1860,
        380
      ],
      "parameters": {}
    },
    {
      "id": "email_approval",
      "name": "Email: Ask Approval",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2720,
        200
      ],
      "parameters": {
        "operation": "sendAndWait",
        "fromEmail": "={{ $('Config').item.json.approvalEmail }}",
        "sendTo": "={{ $('Config').item.json.approvalEmail }}",
        "subject": "=رد جديد يحتاج موافقتك — {{ $('Normalized Comment').item.json.platform }} — {{ $('Normalized Comment').item.json.authorName }}",
        "message": "=تعليق من {{ $('Normalized Comment').item.json.authorName }} ({{ $('Normalized Comment').item.json.platform }}):\n\n\"{{ $('Normalized Comment').item.json.text }}\"\n\nنوع العميل: {{ $json.client_type }}\n\nالرد المقترح:\n\"{{ $json.reply }}\"",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE_IN_UI",
          "name": "Gmail SMTP (app password)"
        }
      },
      "notes": "n8n's built-in human-in-the-loop: sends the email with Approve/Disapprove buttons and PAUSES this execution until a button is clicked (waiting executions are persisted by n8n and survive restarts). Output: $json.data.approved (true/false). Best-effort scaffold -- after import, open this node and confirm the operation is 'Send and Wait for Response' with Response Type 'Approval', and re-select the SMTP credential."
    },
    {
      "id": "approval_decision",
      "name": "Approval Decision",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2940,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sheets_posted",
      "name": "Log To Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2300,
        380
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_IN_UI_SELECT_SPREADSHEET"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_IN_UI_SELECT_SHEET"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "التاريخ": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}",
            "المنصة": "={{ $('Normalized Comment').item.json.platform }}",
            "اسم العميل": "={{ $('Normalized Comment').item.json.authorName }}",
            "التعليق": "={{ $('Normalized Comment').item.json.text }}",
            "نوع العميل": "={{ $('Parse AI JSON').item.json.client_type }}",
            "الرد": "={{ $('Parse AI JSON').item.json.reply }}",
            "الحالة": "={{ $('Parse AI JSON').item.json.needs_human ? 'تمت الموافقة يدويًا' : 'تم الرد تلقائيًا' }}"
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_IN_UI",
          "name": "Google Sheets account"
        }
      },
      "notes": "Best-effort scaffold for the Google Sheets node -- after import: select your Google Sheets OAuth credential, pick the real spreadsheet + sheet from the dropdowns, and confirm the column mapping matches the Arabic headers (see GUIDE.md for the sheet layout to create)."
    },
    {
      "id": "sheets_rejected",
      "name": "Log: Rejected",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        3160,
        280
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_IN_UI_SELECT_SPREADSHEET"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_IN_UI_SELECT_SHEET"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "التاريخ": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}",
            "المنصة": "={{ $('Normalized Comment').item.json.platform }}",
            "اسم العميل": "={{ $('Normalized Comment').item.json.authorName }}",
            "التعليق": "={{ $('Normalized Comment').item.json.text }}",
            "نوع العميل": "={{ $('Parse AI JSON').item.json.client_type }}",
            "الرد": "={{ $('Parse AI JSON').item.json.reply }}",
            "الحالة": "مرفوض — لم يُنشر"
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_IN_UI",
          "name": "Google Sheets account"
        }
      },
      "notes": "Best-effort scaffold for the Google Sheets node -- after import: select your Google Sheets OAuth credential, pick the real spreadsheet + sheet from the dropdowns, and confirm the column mapping matches the Arabic headers (see GUIDE.md for the sheet layout to create)."
    }
  ],
