{
  "name": "01 - Comment Reply Engine",
  "nodes": [
    {
      "id": "t1",
      "name": "Schedule: Poll YouTube",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "t2",
      "name": "From Meta Webhook Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "platform"
            },
            {
              "name": "commentId"
            },
            {
              "name": "text"
            },
            {
              "name": "authorName"
            },
            {
              "name": "postId"
            }
          ]
        }
      },
      "notes": "Called by 02-meta-webhook-router.json's Execute Workflow node with one normalized IG/FB comment."
    },
    {
      "id": "t3",
      "name": "Telegram: Approval Callback",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        400
      ],
      "parameters": {
        "updates": [
          "callback_query"
        ]
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_IN_UI",
          "name": "Telegram bot (comment-reply)"
        }
      }
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        200
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "channelId",
              "type": "string",
              "value": "REPLACE_WITH_YOUTUBE_CHANNEL_ID"
            },
            {
              "id": "a2",
              "name": "igUserId",
              "type": "string",
              "value": "REPLACE_WITH_IG_USER_ID"
            },
            {
              "id": "a3",
              "name": "fbPageId",
              "type": "string",
              "value": "REPLACE_WITH_FB_PAGE_ID"
            },
            {
              "id": "a4",
              "name": "telegramChatId",
              "type": "string",
              "value": "REPLACE_WITH_TELEGRAM_CHAT_ID"
            },
            {
              "id": "a5",
              "name": "systemPrompt",
              "type": "string",
              "value": "REPLACE_WITH_SYSTEM_PROMPT_TXT_CONTENTS"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true
      },
      "notes": "Single source of truth for the 4 IDs + system prompt. Phase 4 of GUIDE.md patches these 5 values via the n8n REST API. keepOnlySet is off (see options) so each entry's own fields (schedule/webhook/telegram payload) pass through untouched."
    },
    {
      "id": "router",
      "name": "Route By Entry",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.callback_query }}",
                    "rightValue": "",
                    "operator": {
                      "type": "object",
                      "operation": "exists"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Approval Callback"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "exists"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Comment Ready For AI"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      },
      "notes": "3 outputs: has callback_query -> approval flow; has platform (came from Meta router) -> straight to AI; fallback (neither) -> came from the Schedule Trigger, go fetch YouTube comments."
    },
    {
      "id": "yt_list",
      "name": "YouTube: List Comment Threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        500
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/commentThreads",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            },
            {
              "name": "allThreadsRelatedToChannelId",
              "value": "={{ $('Config').item.json.channelId }}"
            },
            {
              "name": "order",
              "value": "time"
            },
            {
              "name": "maxResults",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "REPLACE_IN_UI",
          "name": "YouTube OAuth2 account"
        }
      }
    },
    {
      "id": "yt_split",
      "name": "Split Comment Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        960,
        500
      ],
      "parameters": {
        "fieldToSplitOut": "items"
      }
    },
    {
      "id": "yt_dedup",
      "name": "Filter: Not Already Seen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1180,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "ifRowDoesNotExist",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "yt_seen_comments"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "comment_id",
              "condition": "eq",
              "keyValue": "={{ $json.snippet.topLevelComment.id }}"
            }
          ],
          "matchType": "allFilters"
        }
      },
      "notes": "Best-effort scaffold for n8n's Data Table node -- I could not fully verify the exact internal parameter schema from docs alone. Before using: create this Data Table in the n8n UI first (see GUIDE.md), then open this node, re-select the table from the dropdown, and re-check the column mapping / filter -- the operation and table name are right, the exact field layout may need a small fix. Passes the item through only when no row with this comment_id exists yet -- i.e. this IS the dedup check. If your n8n version doesn't have this operation, use 'Get' + a manual IF instead."
    },
    {
      "id": "yt_mark_seen",
      "name": "Mark As Seen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1400,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "yt_seen_comments"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "comment_id": "={{ $json.snippet.topLevelComment.id }}"
          },
          "matchingColumns": []
        }
      },
      "notes": "Best-effort scaffold for n8n's Data Table node -- I could not fully verify the exact internal parameter schema from docs alone. Before using: create this Data Table in the n8n UI first (see GUIDE.md), then open this node, re-select the table from the dropdown, and re-check the column mapping / filter -- the operation and table name are right, the exact field layout may need a small fix."
    },
    {
      "id": "yt_normalize",
      "name": "Normalize: YouTube Comment",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1620,
        440
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "platform",
              "type": "string",
              "value": "youtube"
            },
            {
              "id": "b2",
              "name": "commentId",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.topLevelComment.id }}"
            },
            {
              "id": "b3",
              "name": "text",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.topLevelComment.snippet.textOriginal }}"
            },
            {
              "id": "b4",
              "name": "authorName",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.topLevelComment.snippet.authorDisplayName }}"
            },
            {
              "id": "b5",
              "name": "postId",
              "type": "string",
              "value": "={{ $('Split Comment Items').item.json.snippet.videoId }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "normalized",
      "name": "Normalized Comment",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1840,
        300
      ],
      "parameters": {},
      "notes": "Convergence point for the YouTube branch and the Meta-router branch. Downstream nodes reference $('Normalized Comment').item.json.x regardless of which entry fired."
    },
    {
      "id": "claude",
      "name": "Claude: Generate Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2060,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-haiku-4-5\",\n  max_tokens: 300,\n  system: $('Config').item.json.systemPrompt,\n  messages: [ { role: \"user\", content: $('Normalized Comment').item.json.text } ]\n}) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_IN_UI",
          "name": "Anthropic API (x-api-key header)"
        }
      },
      "notes": "Generic Header Auth credential: header name 'x-api-key', value = your Anthropic API key. See GUIDE.md Phase 3."
    },
    {
      "id": "parse",
      "name": "Parse AI JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const raw = $json.content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // Model didn't return clean JSON -- fail safe to human review rather than guess.\n  parsed = { reply: '', needs_human: true, parse_error: raw };\n}\nreturn { json: { ...$json, reply: parsed.reply, needs_human: parsed.needs_human === true } };"
      }
    },
    {
      "id": "needshuman",
      "name": "Needs Human Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.needs_human }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "insert_pending",
      "name": "Insert Pending Review",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        2720,
        200
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "pending_reviews"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "platform": "={{ $('Normalized Comment').item.json.platform }}",
            "comment_id": "={{ $('Normalized Comment').item.json.commentId }}",
            "post_id": "={{ $('Normalized Comment').item.json.postId }}",
            "draft_reply": "={{ $json.reply }}",
            "status": "pending"
          },
          "matchingColumns": []
        }
      },
      "notes": "Best-effort scaffold for n8n's Data Table node -- I could not fully verify the exact internal parameter schema from docs alone. Before using: create this Data Table in the n8n UI first (see GUIDE.md), then open this node, re-select the table from the dropdown, and re-check the column mapping / filter -- the operation and table name are right, the exact field layout may need a small fix. Expects the Insert operation to return the created row including its auto id -- referenced downstream as $('Insert Pending Review').item.json.id. Confirm that's the actual output shape after import; Data Tables auto-generate an id column per n8n's docs."
    },
    {
      "id": "send_approval",
      "name": "Send Approval Request",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2940,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Config').item.json.telegramChatId }}",
        "text": "=New comment from {{ $('Normalized Comment').item.json.authorName }} ({{ $('Normalized Comment').item.json.platform }}):\n\n\"{{ $('Normalized Comment').item.json.text }}\"\n\nDraft reply:\n\"{{ $('Insert Pending Review').item.json.reply || $json.reply }}\"",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Approve",
                    "additionalFields": {
                      "callback_data": "=approve:{{ $('Insert Pending Review').item.json.id }}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "=reject:{{ $('Insert Pending Review').item.json.id }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_IN_UI",
          "name": "Telegram bot (comment-reply)"
        }
      },
      "notes": "Execution ends here for the auto-detected-sensitive path. It resumes independently via the 'Telegram: Approval Callback' trigger when the human taps a button -- see GUIDE.md's note on why this uses a callback trigger instead of a Wait node."
    },
    {
      "id": "parse_cb",
      "name": "Parse Callback Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        620
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const data = $json.callback_query.data; // e.g. 'approve:<uuid>'\nconst [action, reviewId] = data.split(':');\nreturn { json: { ...$json, action, reviewId } };"
      }
    },
    {
      "id": "fetch_pending",
      "name": "Fetch Pending Review",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        480,
        620
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "pending_reviews"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.reviewId }}"
            }
          ],
          "matchType": "allFilters"
        }
      },
      "notes": "Best-effort scaffold for n8n's Data Table node -- I could not fully verify the exact internal parameter schema from docs alone. Before using: create this Data Table in the n8n UI first (see GUIDE.md), then open this node, re-select the table from the dropdown, and re-check the column mapping / filter -- the operation and table name are right, the exact field layout may need a small fix."
    },
    {
      "id": "approved",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        620
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Parse Callback Data').item.json.action }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "normalize_approved",
      "name": "Normalize: Approved Review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        560
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "platform",
              "type": "string",
              "value": "={{ $('Fetch Pending Review').item.json.platform }}"
            },
            {
              "id": "c2",
              "name": "commentId",
              "type": "string",
              "value": "={{ $('Fetch Pending Review').item.json.comment_id }}"
            },
            {
              "id": "c3",
              "name": "postId",
              "type": "string",
              "value": "={{ $('Fetch Pending Review').item.json.post_id }}"
            },
            {
              "id": "c4",
              "name": "reply",
              "type": "string",
              "value": "={{ $('Fetch Pending Review').item.json.draft_reply }}"
            },
            {
              "id": "c5",
              "name": "reviewId",
              "type": "string",
              "value": "={{ $('Fetch Pending Review').item.json.id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "mark_rejected",
      "name": "Mark Rejected",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        920,
        720
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "pending_reviews"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Parse Callback Data').item.json.reviewId }}"
            }
          ],
          "matchType": "allFilters"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "rejected"
          },
          "matchingColumns": []
        }
      },
      "notes": "Best-effort scaffold for n8n's Data Table node -- I could not fully verify the exact internal parameter schema from docs alone. Before using: create this Data Table in the n8n UI first (see GUIDE.md), then open this node, re-select the table from the dropdown, and re-check the column mapping / filter -- the operation and table name are right, the exact field layout may need a small fix."
    },
    {
      "id": "confirm_rejected",
      "name": "Confirm Rejected",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1140,
        720
      ],
      "parameters": {
        "resource": "message",
        "operation": "editMessageText",
        "chatId": "={{ $('Parse Callback Data').item.json.callback_query.message.chat.id }}",
        "messageId": "={{ $('Parse Callback Data').item.json.callback_query.message.message_id }}",
        "text": "=Rejected -- nothing was posted.\n\n{{ $('Parse Callback Data').item.json.callback_query.message.text }}"
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_IN_UI",
          "name": "Telegram bot (comment-reply)"
        }
      }
    },
    {
      "id": "ready",
      "name": "Ready To Post",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1160,
        380
      ],
      "parameters": {},
      "notes": "Convergence: auto-approved (needs_human=false) replies AND human-approved replies both land here."
    },
    {
      "id": "platform_switch",
      "name": "Route By Platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1380,
        380
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "rightValue": "youtube",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "YouTube"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ ['instagram','facebook'].includes($json.platform) }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Meta (IG/FB)"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "yt_post",
      "name": "YouTube: Post Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/youtube/v3/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ snippet: { parentId: $json.commentId, textOriginal: $json.reply } }) }}",
        "options": {}
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "REPLACE_IN_UI",
          "name": "YouTube OAuth2 account"
        }
      }
    },
    {
      "id": "meta_post",
      "name": "Meta: Post Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        460
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v21.0/' + $json.commentId + '/replies' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.reply }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_IN_UI",
          "name": "Meta Graph API token"
