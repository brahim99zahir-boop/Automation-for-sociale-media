{
  "name": "03 - Error Handler",
  "nodes": [
    {
      "id": "err1",
      "name": "On Any Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "fmt",
      "name": "Format Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "telegramChatId",
              "type": "string",
              "value": "REPLACE_WITH_TELEGRAM_CHAT_ID"
            },
            {
              "id": "e2",
              "name": "workflowName",
              "type": "string",
              "value": "={{ $json.workflow.name }}"
            },
            {
              "id": "e3",
              "name": "failedNode",
              "type": "string",
              "value": "={{ $json.execution.lastNodeExecuted }}"
            },
            {
              "id": "e4",
              "name": "errorMessage",
              "type": "string",
              "value": "={{ $json.execution.error.message }}"
            },
            {
              "id": "e5",
              "name": "executionUrl",
              "type": "string",
              "value": "={{ $json.execution.url }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "alert",
      "name": "Send Error Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.telegramChatId }}",
        "text": "=⚠️ n8n workflow error\n\nWorkflow: {{ $json.workflowName }}\nNode: {{ $json.failedNode }}\nError: {{ $json.errorMessage }}\n\n{{ $json.executionUrl }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_IN_UI",
          "name": "Telegram bot (comment-reply)"
        }
      }
    }
  ],
  "connections": {
    "On Any Workflow Error": {
      "main": [
        [
          {
            "node": "Format Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert": {
      "main": [
        [
          {
            "node": "Send Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}