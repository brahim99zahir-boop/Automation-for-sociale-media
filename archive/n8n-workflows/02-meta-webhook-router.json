{
  "name": "02 - Meta Webhook Router",
  "nodes": [
    {
      "id": "v1",
      "name": "Meta: Verify (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "meta-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "notes": "Production URL: https://n8n.<domain>/webhook/meta-webhook -- paste this into Meta App > Webhooks along with a verify token of your choosing (any string), matched below."
    },
    {
      "id": "vconfig",
      "name": "Config: Verify Token",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "v1",
              "name": "expectedVerifyToken",
              "type": "string",
              "value": "REPLACE_WITH_YOUR_CHOSEN_META_VERIFY_TOKEN"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "vcheck",
      "name": "Token Matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $json.expectedVerifyToken }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "vreturn",
      "name": "Return Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        -80
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {}
      }
    },
    {
      "id": "vreject",
      "name": "Reject Verification",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        80
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": {
          "responseCode": 403
        }
      }
    },
    {
      "id": "ev1",
      "name": "Meta: Events (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        260
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "meta-webhook",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "evack",
      "name": "Ack 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        220,
        200
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {}
      },
      "notes": "Meta expects a fast 200 -- respond immediately, process in parallel below (n8n runs both branches off this node's single output)."
    },
    {
      "id": "normalize",
      "name": "Normalize Meta Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        340
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Meta sends: { entry: [ { changes: [ { field, value } ] } ] } for Page/IG events.\n// This walks every entry/change and emits one normalized item per new comment.\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body;\n  for (const entry of (body.entry || [])) {\n    for (const change of (entry.changes || [])) {\n      const v = change.value || {};\n      // Instagram comment webhooks put fields at value.*; Facebook feed comments similarly.\n      if (change.field === 'comments' || change.field === 'feed') {\n        out.push({ json: {\n          platform: body.object === 'instagram' ? 'instagram' : 'facebook',\n          commentId: v.id || (v.comment_id),\n          text: v.text || (v.message),\n          authorName: (v.from && v.from.username) || (v.from && v.from.name) || 'unknown',\n          postId: v.media ? v.media.id : v.post_id\n        } });\n      }\n    }\n  }\n}\nreturn out;"
      },
      "notes": "Adjust field mapping once you see a real Meta payload in an execution -- Graph API webhook shapes vary slightly between IG comments and FB feed comments; this covers the common case."
    },
    {
      "id": "call_engine",
      "name": "Send To Comment-Reply-Engine",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        340
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_01_ENGINE_WORKFLOW_ID",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "platform": "={{ $json.platform }}",
            "commentId": "={{ $json.commentId }}",
            "text": "={{ $json.text }}",
            "authorName": "={{ $json.authorName }}",
            "postId": "={{ $json.postId }}"
          }
        }
      }
    }
  ],
  "connections": {
    "Meta: Verify (GET)": {
      "main": [
        [
          {
            "node": "Config: Verify Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config: Verify Token": {
      "main": [
        [
          {
            "node": "Token Matches?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token Matches?": {
      "main": [
        [
          {
            "node": "Return Challenge",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Verification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Meta: Events (POST)": {
      "main": [
        [
          {
            "node": "Ack 200",
            "type": "main",
            "index": 0
          },
          {
            "node": "Normalize Meta Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Meta Payload": {
      "main": [
        [
          {
            "node": "Send To Comment-Reply-Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "REPLACE_WITH_03_ERROR_HANDLER_WORKFLOW_ID"
  }
}