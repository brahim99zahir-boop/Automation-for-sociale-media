# .env for this n8n deployment (single-process mode + Postgres).
# Copy to `.env` on the server and fill in. NEVER commit the real .env.
# NEVER copy values from another n8n instance — generate fresh secrets on THIS box
# (setup-commands.sh does this for you with `openssl rand -base64 ...`).

# --- where the project lives on the host (absolute path) ---
# MUST be the directory you put docker-compose.yml in and run `docker compose` from.
DATA_FOLDER=/opt/n8n

# --- your domain: final URL becomes https://SUBDOMAIN.DOMAIN_NAME/ ---
DOMAIN_NAME=example.com
SUBDOMAIN=n8n

# --- email used by Caddy for the TLS certificate (Let's Encrypt) ---
SSL_EMAIL=you@example.com

# --- timezone for Schedule/Cron nodes (used by the YouTube-polling trigger) ---
GENERIC_TIMEZONE=Africa/Casablanca

# --- pin the n8n image (recommended) or leave "stable" ---
N8N_IMAGE_TAG=stable

# --- ENCRYPTION KEY: generate on the box with `openssl rand -base64 32`. ---
# This encrypts all stored credentials (Anthropic key, YouTube OAuth tokens, Meta
# token, Telegram bot token). If you lose it, every saved credential becomes
# undecryptable. Back it up somewhere safe and OUTSIDE this box.
N8N_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32

# --- Postgres ---
# Superuser (admin) — used only to bootstrap the database + the non-root user.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_base64_24
POSTGRES_DB=n8n
# Non-root user n8n (and our own comment-reply tables) actually connect with.
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=REPLACE_WITH_openssl_rand_base64_24
